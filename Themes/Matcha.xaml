<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="Theme.Id">Matcha</sys:String>
    <sys:String x:Key="Theme.Name">Matcha Latte</sys:String>
    <sys:Boolean x:Key="Theme.IsDark">False</sys:Boolean>

    <Color x:Key="C.Bg">#F1F7EF</Color>
    <Color x:Key="C.Bg2">#E4EFDF</Color>
    <Color x:Key="C.Surface">#FFFFFF</Color>
    <Color x:Key="C.SurfaceAlt">#F4F9F1</Color>
    <Color x:Key="C.Sunken">#E9F2E4</Color>
    <Color x:Key="C.Border">#D8E7D0</Color>
    <Color x:Key="C.BorderStrong">#C3D9B8</Color>
    <Color x:Key="C.Text">#38473A</Color>
    <Color x:Key="C.TextMuted">#5F6F5E</Color>
    <Color x:Key="C.TextSubtle">#92A18E</Color>
    <Color x:Key="C.TextInverse">#FFFFFF</Color>
    <Color x:Key="C.Primary">#8FBF7F</Color>
    <Color x:Key="C.PrimaryHover">#7BAE6B</Color>
    <Color x:Key="C.PrimarySoft">#E2F0DA</Color>
    <Color x:Key="C.OnPrimary">#FFFFFF</Color>
    <Color x:Key="C.Secondary">#E7B27A</Color>
    <Color x:Key="C.SecondarySoft">#F8E7D2</Color>
    <Color x:Key="C.Accent">#7FC1C7</Color>
    <Color x:Key="C.AccentSoft">#DBF0F1</Color>
    <Color x:Key="C.Success">#7FB98F</Color>
    <Color x:Key="C.Warning">#E7B255</Color>
    <Color x:Key="C.Danger">#E08A8A</Color>
    <Color x:Key="C.Info">#86B0D0</Color>
    <Color x:Key="C.Coin">#D89A34</Color>
    <Color x:Key="C.Nav">#FFFFFF</Color>
    <Color x:Key="C.NavText">#5F6F5E</Color>
    <Color x:Key="C.NavActive">#8FBF7F</Color>
    <Color x:Key="C.PageArea">#E7F1E1</Color>
    <Color x:Key="C.Shadow">#A9C79A</Color>

</ResourceDictionary>
