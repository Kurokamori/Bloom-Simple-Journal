<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="Theme.Id">Midnight</sys:String>
    <sys:String x:Key="Theme.Name">Midnight Bloom</sys:String>
    <sys:Boolean x:Key="Theme.IsDark">True</sys:Boolean>

    <Color x:Key="C.Bg">#201B2E</Color>
    <Color x:Key="C.Bg2">#191524</Color>
    <Color x:Key="C.Surface">#2A2440</Color>
    <Color x:Key="C.SurfaceAlt">#322B4A</Color>
    <Color x:Key="C.Sunken">#241F36</Color>
    <Color x:Key="C.Border">#3D3557</Color>
    <Color x:Key="C.BorderStrong">#4E4470</Color>
    <Color x:Key="C.Text">#EDE7F7</Color>
    <Color x:Key="C.TextMuted">#B6ACCB</Color>
    <Color x:Key="C.TextSubtle">#8578A0</Color>
    <Color x:Key="C.TextInverse">#2A2440</Color>
    <Color x:Key="C.Primary">#B79CE8</Color>
    <Color x:Key="C.PrimaryHover">#C6B0F0</Color>
    <Color x:Key="C.PrimarySoft">#3A3157</Color>
    <Color x:Key="C.OnPrimary">#201B2E</Color>
    <Color x:Key="C.Secondary">#F4A9C8</Color>
    <Color x:Key="C.SecondarySoft">#47324A</Color>
    <Color x:Key="C.Accent">#8FD3C7</Color>
    <Color x:Key="C.AccentSoft">#2C3F44</Color>
    <Color x:Key="C.Success">#86C7A0</Color>
    <Color x:Key="C.Warning">#F0C05A</Color>
    <Color x:Key="C.Danger">#E88A9A</Color>
    <Color x:Key="C.Info">#8FB8DE</Color>
    <Color x:Key="C.Coin">#F0C05A</Color>
    <Color x:Key="C.Nav">#2A2440</Color>
    <Color x:Key="C.NavText">#B6ACCB</Color>
    <Color x:Key="C.NavActive">#B79CE8</Color>
    <Color x:Key="C.PageArea">#191524</Color>
    <Color x:Key="C.Shadow">#0D0A16</Color>

</ResourceDictionary>
