<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="Theme.Id">Strawberry</sys:String>
    <sys:String x:Key="Theme.Name">Strawberry Milk</sys:String>
    <sys:Boolean x:Key="Theme.IsDark">False</sys:Boolean>

    <Color x:Key="C.Bg">#FEF3F6</Color>
    <Color x:Key="C.Bg2">#FBE6EE</Color>
    <Color x:Key="C.Surface">#FFFFFF</Color>
    <Color x:Key="C.SurfaceAlt">#FFF1F5</Color>
    <Color x:Key="C.Sunken">#FCE7EE</Color>
    <Color x:Key="C.Border">#F6D8E2</Color>
    <Color x:Key="C.BorderStrong">#EFC2D2</Color>
    <Color x:Key="C.Text">#5A3B47</Color>
    <Color x:Key="C.TextMuted">#8A6673</Color>
    <Color x:Key="C.TextSubtle">#B892A0</Color>
    <Color x:Key="C.TextInverse">#FFFFFF</Color>
    <Color x:Key="C.Primary">#F48FB1</Color>
    <Color x:Key="C.PrimaryHover">#EC7BA2</Color>
    <Color x:Key="C.PrimarySoft">#FCE0EA</Color>
    <Color x:Key="C.OnPrimary">#FFFFFF</Color>
    <Color x:Key="C.Secondary">#F6C177</Color>
    <Color x:Key="C.SecondarySoft">#FDEFD8</Color>
    <Color x:Key="C.Accent">#9AD0C2</Color>
    <Color x:Key="C.AccentSoft">#E0F1EC</Color>
    <Color x:Key="C.Success">#86C7A0</Color>
    <Color x:Key="C.Warning">#F0B84A</Color>
    <Color x:Key="C.Danger">#E5768C</Color>
    <Color x:Key="C.Info">#9BBDE4</Color>
    <Color x:Key="C.Coin">#E39A2E</Color>
    <Color x:Key="C.Nav">#FFFFFF</Color>
    <Color x:Key="C.NavText">#8A6673</Color>
    <Color x:Key="C.NavActive">#F48FB1</Color>
    <Color x:Key="C.PageArea">#F9E4EC</Color>
    <Color x:Key="C.Shadow">#E0A9BC</Color>

</ResourceDictionary>
