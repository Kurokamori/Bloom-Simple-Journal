<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="Theme.Id">Lavender</sys:String>
    <sys:String x:Key="Theme.Name">Lavender Dream</sys:String>
    <sys:Boolean x:Key="Theme.IsDark">False</sys:Boolean>

    <Color x:Key="C.Bg">#F6F1FB</Color>
    <Color x:Key="C.Bg2">#ECE3F6</Color>
    <Color x:Key="C.Surface">#FFFFFF</Color>
    <Color x:Key="C.SurfaceAlt">#F8F3FD</Color>
    <Color x:Key="C.Sunken">#F0E9FA</Color>
    <Color x:Key="C.Border">#E6DAF3</Color>
    <Color x:Key="C.BorderStrong">#D3C2E8</Color>
    <Color x:Key="C.Text">#3E3450</Color>
    <Color x:Key="C.TextMuted">#6D6280</Color>
    <Color x:Key="C.TextSubtle">#9A8FB0</Color>
    <Color x:Key="C.TextInverse">#FFFFFF</Color>
    <Color x:Key="C.Primary">#B79CE8</Color>
    <Color x:Key="C.PrimaryHover">#A487DD</Color>
    <Color x:Key="C.PrimarySoft">#EBE1FB</Color>
    <Color x:Key="C.OnPrimary">#FFFFFF</Color>
    <Color x:Key="C.Secondary">#F4A9C8</Color>
    <Color x:Key="C.SecondarySoft">#FCE4EE</Color>
    <Color x:Key="C.Accent">#8FD3C7</Color>
    <Color x:Key="C.AccentSoft">#DDF2ED</Color>
    <Color x:Key="C.Success">#86C7A0</Color>
    <Color x:Key="C.Warning">#F0C05A</Color>
    <Color x:Key="C.Danger">#E88A9A</Color>
    <Color x:Key="C.Info">#8FB8DE</Color>
    <Color x:Key="C.Coin">#E6A93B</Color>
    <Color x:Key="C.Nav">#FFFFFF</Color>
    <Color x:Key="C.NavText">#6D6280</Color>
    <Color x:Key="C.NavActive">#B79CE8</Color>
    <Color x:Key="C.PageArea">#EDE6F6</Color>
    <Color x:Key="C.Shadow">#B0A0C8</Color>

</ResourceDictionary>
