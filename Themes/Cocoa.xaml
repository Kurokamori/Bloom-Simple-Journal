<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="Theme.Id">Cocoa</sys:String>
    <sys:String x:Key="Theme.Name">Cocoa Cocoon</sys:String>
    <sys:Boolean x:Key="Theme.IsDark">True</sys:Boolean>

    <Color x:Key="C.Bg">#29211D</Color>
    <Color x:Key="C.Bg2">#211A16</Color>
    <Color x:Key="C.Surface">#362B25</Color>
    <Color x:Key="C.SurfaceAlt">#40332B</Color>
    <Color x:Key="C.Sunken">#2E251F</Color>
    <Color x:Key="C.Border">#4A3B31</Color>
    <Color x:Key="C.BorderStrong">#5D4A3D</Color>
    <Color x:Key="C.Text">#F1E7DE</Color>
    <Color x:Key="C.TextMuted">#C4B2A4</Color>
    <Color x:Key="C.TextSubtle">#94806F</Color>
    <Color x:Key="C.TextInverse">#362B25</Color>
    <Color x:Key="C.Primary">#E0A57A</Color>
    <Color x:Key="C.PrimaryHover">#EBB78E</Color>
    <Color x:Key="C.PrimarySoft">#46362C</Color>
    <Color x:Key="C.OnPrimary">#29211D</Color>
    <Color x:Key="C.Secondary">#C9A0E0</Color>
    <Color x:Key="C.SecondarySoft">#3E3348</Color>
    <Color x:Key="C.Accent">#8FC0A9</Color>
    <Color x:Key="C.AccentSoft">#2E3E35</Color>
    <Color x:Key="C.Success">#8FC0A9</Color>
    <Color x:Key="C.Warning">#ECC069</Color>
    <Color x:Key="C.Danger">#E19292</Color>
    <Color x:Key="C.Info">#94B6D0</Color>
    <Color x:Key="C.Coin">#ECC069</Color>
    <Color x:Key="C.Nav">#362B25</Color>
    <Color x:Key="C.NavText">#C4B2A4</Color>
    <Color x:Key="C.NavActive">#E0A57A</Color>
    <Color x:Key="C.PageArea">#211A16</Color>
    <Color x:Key="C.Shadow">#140F0C</Color>

</ResourceDictionary>
